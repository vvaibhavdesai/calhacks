# Root environment file consumed by infra/docker-compose.yml.
# Copy to .env and fill in local values. Never commit the real .env file.
#
# This file intentionally leaves secrets blank. Missing required values
# cause the API/worker to fail fast at startup with a clear error rather
# than silently running unauthenticated or unauthorized.

# --- Postgres (local docker-compose) ---
POSTGRES_USER=encore
POSTGRES_PASSWORD=encore_dev_password
POSTGRES_DB=encore
POSTGRES_PORT=5432

# --- API / worker ---
# SQLAlchemy/psycopg URL. Must use postgresql+psycopg:// (no SQLite, per product constraints).
# This is the SCHEMA-OWNING role (used by `alembic upgrade`, scripts/seed_admin.py, and
# local pytest runs that need CREATE/DROP TABLE). The actually-running API/worker
# containers in infra/docker-compose.yml connect as the more restricted `encore_app`
# role instead (see ENCORE_APP_DB_PASSWORD below and
# db/migrations/versions/0003_app_role_privileges.py) -- that role cannot UPDATE or
# DELETE the append-only audit/journal tables, enforced by Postgres GRANT/REVOKE.
DATABASE_URL=postgresql+psycopg://encore:encore_dev_password@localhost:5432/encore

# Password for the restricted `encore_app` runtime role created by migration
# 0003_app_role_privileges. A committed local-dev default, not a production secret
# (same pattern as POSTGRES_PASSWORD above) -- A10 overrides this for a real deployment.
ENCORE_APP_DB_PASSWORD=encore_app_dev_password

# Symmetric signing secret for server-issued session JWTs (see docs/adr/0001-runtime.md).
# Required. The API refuses to start without it.
AUTH_JWT_SECRET=

# Access token lifetime in minutes.
AUTH_TOKEN_TTL_MINUTES=60

# Local document-storage adapter (pluggable interface; see services/api/app/storage).
# "local" writes under DOCUMENT_STORAGE_ROOT. A real object-store adapter is a later swap.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=./.data/documents

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# --- Bootstrap admin (one initial user holding all capabilities, per AGENT_HANDOFF.md) ---
# Used only by scripts/seed_admin.py. Leave blank to skip seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# --- Anthropic (A06) ---
# Server-side only; put the real key in .env (gitignored), never here.
# Model selected by the user for A06 on 2026-10-24 (docs/adr/0001-runtime.md).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Nightly close orchestration worker (A06 stage 3) ---
# 1 = the worker process runs the LangGraph nightly-close loop.
ORCHESTRATION_WORKER_ENABLED=1
ORCHESTRATION_LEASE_SECONDS=30
ORCHESTRATION_POLL_SECONDS=2
ORCHESTRATION_LLM_TIMEOUT_SECONDS=60
# Fault injection for verification only (ignored when APP_ENV=production).
# The outbox dispatcher uses the same hook: outbox:after_claim@<intent_id>,
# outbox:after_dispatch@<payout_id>.
# ORCHESTRATION_CRASH_POINTS=pay:after_release@<vendor_id>
# ORCHESTRATION_CRASH_MODE=exit

# --- Outbox dispatcher (services/worker/worker/outbox.py) ---
# 1 = the worker process delivers PENDING outbox intents. Without it every
# intent stays PENDING until somebody makes an HTTP call by hand.
OUTBOX_DISPATCHER_ENABLED=1
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH=20
OUTBOX_LEASE_SECONDS=60
# Bounded retry: after this many attempts an intent is dead-lettered and
# never retried. It deliberately stays PENDING in outbox_intents so the
# OUTBOX_BACKLOG alert keeps pointing at it until a human acts.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_SECONDS=15
OUTBOX_BACKOFF_CAP_SECONDS=900
# 1 = a payout.dispatch intent is held back until its night's simulated
# payout release window (SCHEDULE_PAYOUT_RELEASE_AT on business_date + 1).
OUTBOX_RELEASE_WINDOW_ENABLED=1
# How often a demo-clock-deferred intent re-checks that window, in real
# seconds (a frozen demo clock would otherwise never reach it).
OUTBOX_DEFER_RECHECK_SECONDS=60
# Rail outcome used for a payout.dispatch intent that does not name one.
# Never random: a demo that wants FAILED/UNKNOWN says so in the data.
OUTBOX_DEFAULT_SIMULATED_OUTCOME=ACCEPTED

# --- Scheduler (services/worker/worker/scheduler.py) ---
# 1 = the worker fires the nightly close at the times below instead of
# waiting for POST /api/v1/orchestration/runs.
SCHEDULER_ENABLED=1
# REQUIRED for anything to be scheduled. Blank = the loop runs but
# schedules nothing (the safe default for a fresh database).
SCHEDULE_FESTIVAL_ID=
# The user the scheduler acts as. It has no authority of its own: this
# user's capabilities are re-read at fire time and must include
# run_reconciliation. A payout over the $5,000 automatic daily limit still
# holds for a finance lead.
SCHEDULE_ACTOR_EMAIL=admin@example.com
# Festival-local (America/Los_Angeles) times of day. CONTRACTS.md's
# confirmed defaults: 9 AM statements / 10 AM simulated payout.
SCHEDULE_STATEMENTS_AT=09:00
SCHEDULE_PAYOUT_RELEASE_AT=10:00
# Business dates the nightly close will run for; an occurrence outside this
# range is recorded as SKIPPED instead of opening an empty run every day.
SCHEDULE_FIRST_BUSINESS_DATE=2026-10-16
SCHEDULE_LAST_BUSINESS_DATE=2026-10-18
SCHEDULE_POLL_SECONDS=15
# How far back a starting worker will still fire a missed occurrence.
SCHEDULE_CATCHUP_HOURS=24
SCHEDULE_MAX_ATTEMPTS=3
SCHEDULE_LEASE_SECONDS=300
SCHEDULE_MAX_CONCURRENCY=4
SCHEDULE_BUDGET_USD=0
SCHEDULE_EXPLAIN_CASES=0

# --- Demo clock (services/api/app/demo_clock.py) ---
# "enabled" = the stored demo clock drives SCHEDULING decisions, so the
# 2026-10-16..18 timeline can be driven forward deterministically
# (`python -m worker.clock set 2026-10-17T08:59`, `... advance 5m`).
# "off", or APP_ENV=production, makes it inert: scheduling uses the wall
# clock and the mutators refuse. It never affects audit timestamps.
DEMO_CLOCK_MODE=enabled
# --- A10: Claude rate/cost caps (docs/runbooks/operations.md) ---
CLAUDE_MAX_BUDGET_USD_PER_REQUEST=5
CLAUDE_DAILY_BUDGET_USD=20
CLAUDE_MAX_DOCUMENTS_PER_REQUEST=200
CLAUDE_MAX_CONCURRENCY=4
CLAUDE_MAX_BATCHES_PER_HOUR=20

# --- A10: ops alerts and metrics ---
OPS_STALLED_RUN_MINUTES=30
OPS_OUTBOX_STALE_MINUTES=10
OPS_OUTBOX_BACKLOG_MAX=100
# Intent types with NO dispatcher, reported separately and excluded from the
# backlog alert. Both of the types this system enqueues now HAVE a handler
# (app/outbox_dispatch.py), so this is deliberately empty: a PENDING
# source.imported.notify is now real backlog, not "by design".
OPS_OUTBOX_UNCONSUMED_INTENT_TYPES=
# Blank = GET /metrics disabled. Secret: set only in .env.
OPS_METRICS_TOKEN=
# e.g. http://localhost:8100/health/live (blank = worker not probed)
OPS_WORKER_HEALTH_URL=
LOG_LEVEL=INFO

# Production-like stack: see infra/.env.prod.example and docs/deploy.md.

# --- Frontend (public values only; never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000
