# Root environment file consumed by infra/docker-compose.yml.
# Copy to .env and fill in local values. Never commit the real .env file.
#
# This file intentionally leaves secrets blank. Missing required values
# cause the API/worker to fail fast at startup with a clear error rather
# than silently running unauthenticated or unauthorized.

# --- Postgres (local docker-compose) ---
POSTGRES_USER=encore
POSTGRES_PASSWORD=encore_dev_password
POSTGRES_DB=encore
POSTGRES_PORT=5432

# --- API / worker ---
# SQLAlchemy/psycopg URL. Must use postgresql+psycopg:// (no SQLite, per product constraints).
# This is the SCHEMA-OWNING role (used by `alembic upgrade`, scripts/seed_admin.py, and
# local pytest runs that need CREATE/DROP TABLE). The actually-running API/worker
# containers in infra/docker-compose.yml connect as the more restricted `encore_app`
# role instead (see ENCORE_APP_DB_PASSWORD below and
# db/migrations/versions/0003_app_role_privileges.py) -- that role cannot UPDATE or
# DELETE the append-only audit/journal tables, enforced by Postgres GRANT/REVOKE.
DATABASE_URL=postgresql+psycopg://encore:encore_dev_password@localhost:5432/encore

# Password for the restricted `encore_app` runtime role created by migration
# 0003_app_role_privileges. A committed local-dev default, not a production secret
# (same pattern as POSTGRES_PASSWORD above) -- A10 overrides this for a real deployment.
ENCORE_APP_DB_PASSWORD=encore_app_dev_password

# Symmetric signing secret for server-issued session JWTs (see docs/adr/0001-runtime.md).
# Required. The API refuses to start without it.
AUTH_JWT_SECRET=

# Access token lifetime in minutes.
AUTH_TOKEN_TTL_MINUTES=60

# Local document-storage adapter (pluggable interface; see services/api/app/storage).
# "local" writes under DOCUMENT_STORAGE_ROOT. A real object-store adapter is a later swap.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=./.data/documents

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# --- Bootstrap admin (one initial user holding all capabilities, per AGENT_HANDOFF.md) ---
# Used only by scripts/seed_admin.py. Leave blank to skip seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# --- Anthropic (A06) ---
# Server-side only; put the real key in .env (gitignored), never here.
# Model selected by the user for A06 on 2026-10-24 (docs/adr/0001-runtime.md).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Nightly close orchestration worker (A06 stage 3) ---
# 1 = the worker process runs the LangGraph nightly-close loop.
ORCHESTRATION_WORKER_ENABLED=1
ORCHESTRATION_LEASE_SECONDS=30
ORCHESTRATION_POLL_SECONDS=2
ORCHESTRATION_LLM_TIMEOUT_SECONDS=60
# Fault injection for verification only (ignored when APP_ENV=production):
# ORCHESTRATION_CRASH_POINTS=pay:after_release@<vendor_id>
# ORCHESTRATION_CRASH_MODE=exit

# --- Frontend (public values only; never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000
