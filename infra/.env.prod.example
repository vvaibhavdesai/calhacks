# Environment for infra/docker-compose.prod.yml. Copy to infra/.env.prod (or
# inject the same names from the host's secret manager) and fill in.
# infra/.env.prod is gitignored (.env.* rule) -- NEVER commit it.
# Every value left blank below is REQUIRED unless marked optional; compose
# refuses to start without it. Generate secrets with e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Image tag recorded for the release (e.g. the git commit SHA being deployed).
RELEASE_TAG=

# --- PostgreSQL (schema-owning role: migrations, backups, seed-admin) ---
POSTGRES_USER=encore
POSTGRES_PASSWORD=
POSTGRES_DB=encore
# Restricted runtime role used by the API (migration 0003).
ENCORE_APP_DB_PASSWORD=

# --- API ---
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
APP_ENV=production
# Public HTTPS origin users browse to, e.g. https://encore.example.org
PUBLIC_ORIGIN=
# Optional: shared token for scraping GET /metrics (blank = /metrics disabled).
OPS_METRICS_TOKEN=
LOG_LEVEL=INFO

# --- Anthropic (server-side only; never in any VITE_ variable) ---
# Optional: blank = extraction endpoint answers 503 model_not_configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude rate/cost caps (app/agents/limits.py). Spend is an estimate.
CLAUDE_MAX_BUDGET_USD_PER_REQUEST=5
CLAUDE_DAILY_BUDGET_USD=20
CLAUDE_MAX_DOCUMENTS_PER_REQUEST=200
CLAUDE_MAX_CONCURRENCY=4
CLAUDE_MAX_BATCHES_PER_HOUR=20

# --- Ops alert thresholds ---
OPS_STALLED_RUN_MINUTES=30
OPS_OUTBOX_STALE_MINUTES=10

# --- First deploy only (profile "bootstrap"); clear afterwards ---
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Web ---
# Interface/port the web container publishes on the host; put the TLS
# terminator in front of it. 127.0.0.1 = only a local reverse proxy can reach it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
