# Public frontend settings only. Never put secrets here: everything prefixed
# VITE_ is compiled into the browser bundle.
#
# live (default) or fixture (dev/test only; `vite build` refuses fixture).
VITE_ENCORE_DATA_MODE=live
# API origin; empty means same origin (requests go to /api/v1/...).
VITE_ENCORE_API_ORIGIN=
# Optional public sign-in URL shown on 401 (auth provider not yet selected, C00).
VITE_ENCORE_AUTH_LOGIN_URL=
# Dev server only (not exposed to the bundle): proxy /api to a local backend.
ENCORE_DEV_API_PROXY=
